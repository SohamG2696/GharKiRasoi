# Ghar Ki Rasoi - Environment Variables Template

# Server Configuration
PORT=5000

# Database (Supabase PostgreSQL + PostGIS)
# Provide your Supabase project URL and anon public key when connecting to live cloud
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key

# Database Direct URI (Optional, for direct pg pool connection)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Payments Gateway (Razorpay - Optional)
# If omitted, platform automatically activates the secure Interactive Demo Simulator
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_secret_key
